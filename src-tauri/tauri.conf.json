{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenClaude Desktop",
  "version": "0.1.0",
  "identifier": "dev.openclaude.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "OpenClaude Desktop",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "focus": true,
        "visible": false,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Unofficial open-source Claude desktop client",
    "longDescription": "OpenClaude Desktop is an unofficial, open-source desktop client for Claude on Linux. It talks to the Anthropic API directly using your own API key, stores conversations locally in SQLite, and is not affiliated with or endorsed by Anthropic.",
    "copyright": "Copyright (c) 2026 OpenClaude Desktop contributors",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/openclaude/openclaude-desktop",
    "publisher": "OpenClaude Desktop contributors",
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "../assets/openclaude.desktop.template",
        "priority": "optional",
        "files": {
          "/usr/share/metainfo/dev.openclaude.desktop.metainfo.xml": "../assets/dev.openclaude.desktop.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
